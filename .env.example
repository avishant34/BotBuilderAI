# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# LLM Provider (openai | xai | anthropic | deepseek)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=          # optional, for custom endpoints (e.g. https://api.x.ai/v1)

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot_generator.db

# Optional Redis FSM (default false = MemoryStorage)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Optional webhook (default false = pure polling bot)
USE_WEBHOOK=false
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Optional: GitHub for "Push to GitHub" feature
GITHUB_TOKEN=
GITHUB_USERNAME=

# Admin Telegram user IDs (comma separated)
ADMIN_IDS=123456789

# Rate limiting
MAX_BOTS_PER_DAY=10
MAX_GENERATION_TOKENS=16000

# App
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
